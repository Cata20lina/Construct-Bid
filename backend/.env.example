PORT=5000

# PostgreSQL connection string. For a local Postgres instance:
#   DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/construct_bid?schema=public"
# For a hosted free-tier instance (Neon, Supabase, Railway, etc.), paste the
# connection string they give you here instead.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

JWT_SECRET=cheia_ta_secreta_si_lunga

# ── Email (verificare cont) ──────────────────────────────────────────────
# Opțional în dezvoltare: dacă lipsesc, codul de verificare e afișat în
# consola serverului în loc să fie trimis pe email (vezi lib/mailer.js).
# Pentru Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=adresa ta,
# SMTP_PASS=o "App Password" (nu parola contului) — vezi myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── Plăți cu cardul (Stripe) ──────────────────────────────────────────────
# Opțional: dacă lipsesc, achiziția de tokenuri/abonament rămâne "simulată"
# (util pentru dezvoltare/testare fără cont Stripe). Pentru plăți reale:
#   1. Creează cont pe stripe.com, ia cheia secretă din Dashboard → Developers → API keys.
#   2. Pentru webhook local: `stripe listen --forward-to localhost:5000/api/tokenuri/webhook-stripe`
#      îți dă un STRIPE_WEBHOOK_SECRET de test (whsec_...).
#   3. În producție, configurează endpoint-ul de webhook din Dashboard → Developers → Webhooks,
#      cu URL-ul public al backend-ului tău + /api/tokenuri/webhook-stripe.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# URL-ul unde e găzduit frontend-ul — folosit pentru redirect după plata Stripe.
# Poți pune mai multe, separate prin virgulă (primul e folosit pentru redirect).
FRONTEND_URL=http://localhost:5173
