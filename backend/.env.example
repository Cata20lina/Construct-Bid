PORT=5000

# PostgreSQL connection string. For a local Postgres instance:
#   DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/construct_bid?schema=public"
# For a hosted free-tier instance (Neon, Supabase, Railway, etc.), paste the
# connection string they give you here instead.
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"

JWT_SECRET=cheia_ta_secreta_si_lunga

# ── Email (verificare cont) ──────────────────────────────────────────────
# Opțional în dezvoltare: dacă lipsesc, codul de verificare e afișat în
# consola serverului în loc să fie trimis pe email (vezi lib/mailer.js).
# Pentru Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=adresa ta,
# SMTP_PASS=o "App Password" (nu parola contului) — vezi myaccount.google.com/apppasswords
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
